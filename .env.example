# Supabase (Project instellingen -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# Resend (voor e-mails, resend.com)
RESEND_API_KEY=re_xxxxx
# E-mailadres waar jij als beheerder meldingen op ontvangt
ADMIN_EMAIL=klankritueel@gmail.com
# Afzenderadres. Zolang je geen eigen domein hebt geverifieerd bij Resend,
# gebruik je hun test-adres: onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev

# Wachtwoord voor het beheerpaneel (/beheer). Kies zelf iets sterks.
ADMIN_PASSWORD=verander-dit-wachtwoord

# Willekeurige lange, geheime tekenreeks om het inlog-cookie te ondertekenen.
# Kan je zelf verzinnen, hoeft niet onthouden te worden.
AUTH_SECRET=verander-dit-in-een-lange-willekeurige-tekst
